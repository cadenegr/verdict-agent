# Every setting the app reads. Copy to .env (make setup does it) and change values there.
# Variables starting with VITE_ are visible in the browser: never put secrets in them.

VITE_APP_TITLE=verdict-agent
VITE_APP_DESCRIPTION=A command-line agent that judges whether a software product is real, alive and trustworthy, with evidence links.

# Evidence agent (apps/agent)
# Web search: none (default) | claude (uses your Claude Code budget) | tavily (at the event)
SEARCH_PROVIDER=none
TAVILY_API_KEY=
# Command line only, never in .env: REUSE=1 make verdict IN=<file> judges again from
# live/evidence.jsonl (saved search hits reused, failed Wayback lookups retried, sites re-read).
# REUSE=
# Claude judge: none (default) | claude. Claude reads each product against the reviewers'
# checklist and has the last word (decision 7). Uses your Claude Code budget.
JUDGE=none
JUDGE_MODEL=sonnet
